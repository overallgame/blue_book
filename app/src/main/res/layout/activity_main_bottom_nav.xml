<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <RadioGroup
        android:id="@+id/main_navRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/tab_home"
            style="@style/RadioGroupButtonStyle"
            android:text="首页"
            android:textColor="@color/navigation_item_selector" />

        <RadioButton
            android:id="@+id/tab_video"
            style="@style/RadioGroupButtonStyle"
            android:text="视频"
            android:textColor="@color/navigation_item_selector" />

        <!-- 发布入口：小红书风格，位于底部导航栏正中，凸起红色圆形加号 -->
        <FrameLayout
            android:id="@+id/tab_publish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/publish_btn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-24dp"
                android:background="@drawable/shape_publish_circle"
                android:contentDescription="发布视频"
                android:elevation="4dp"
                android:padding="12dp"
                android:src="@drawable/_ic_add_white" />
        </FrameLayout>

        <com.example.blue_book.view.BadgeRadioButton
            android:id="@+id/tab_message"
            style="@style/RadioGroupButtonStyle"
            android:text="消息"
            android:textColor="@color/navigation_item_selector" />

        <RadioButton
            android:id="@+id/tab_mine"
            style="@style/RadioGroupButtonStyle"
            android:text="我"
            android:textColor="@color/navigation_item_selector" />
    </RadioGroup>

</LinearLayout>
