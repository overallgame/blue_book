<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_login_guide_card"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="登录后体验完整功能"
            android:textColor="@color/login_guide_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="登录后即可点赞、评论、发布内容\n并关注喜欢的作者"
            android:textColor="@color/login_guide_desc"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/login_guide_confirm"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/shape_login_guide_btn"
            android:gravity="center"
            android:text="去登录"
            android:textColor="@color/login_guide_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_guide_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="暂不"
            android:textColor="@color/login_guide_desc"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
