<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main_focus_pager_swipeRefreshLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/main_focus_recycleView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@color/md_theme_surfaceContainer"
			android:clipToPadding="false"
			android:padding="4dp" />

		<!-- 未登录空态：点击弹登录引导卡片 -->
		<LinearLayout
			android:id="@+id/home_focus_empty"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="登录后查看关注内容"
				android:textColor="@color/md_theme_onSurfaceVariant"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/home_focus_empty_login"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:background="?attr/selectableItemBackground"
				android:paddingHorizontal="24dp"
				android:paddingVertical="8dp"
				android:text="去登录"
				android:textColor="@color/md_theme_primary"
				android:textSize="14sp" />
		</LinearLayout>

		<!-- 加载失败空态：与上面的未登录空态互斥（登录后加载失败才展示） -->
		<LinearLayout
			android:id="@+id/home_focus_error"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:visibility="gone">

			<TextView
				android:id="@+id/home_focus_error_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="加载失败"
				android:textColor="@color/md_theme_onSurfaceVariant"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/home_focus_error_retry"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:background="?attr/selectableItemBackground"
				android:paddingHorizontal="24dp"
				android:paddingVertical="8dp"
				android:text="重新加载"
				android:textColor="@color/md_theme_primary"
				android:textSize="14sp" />
		</LinearLayout>
	</FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
