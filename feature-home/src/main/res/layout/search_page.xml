<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/search_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_surface"
            android:minHeight="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/_chevron_left1"
            app:navigationIconTint="@color/md_theme_onSurfaceVariant">

            <!-- 输入框与「搜索」按钮必须包一层 LinearLayout：
                 MaterialToolbar 不处理子 View 的 layout_weight，加权 EditText 直接放里面
                 会被量成 0 宽（输入框整个看不见、点不进去）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_comment"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape1"
                    android:drawableStart="@drawable/search_icon2"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:hint="搜索视频"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/md_theme_primary"
                    android:textColorHint="@color/md_theme_outline"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/search_search"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="搜索"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 历史记录：标题 + 清空 + chip 流（无历史时整块隐藏） -->
    <LinearLayout
        android:id="@+id/search_history_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="历史记录"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/search_history_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="清空"
                android:textColor="@color/md_theme_outline"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/search_history_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp" />
    </LinearLayout>

    <!-- 猜你想搜 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:text="猜你想搜"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/search_suggested_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp" />

    <!-- 热点 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:text="热点"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/search_hot_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp" />

</LinearLayout>
