<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <!-- 状态栏内边距加在这一层（见 SearchFragment.initWindowInsets）：
         加在 MaterialToolbar 自身上会让它内部的返回键垂直居中算错——工具栏给返回键
         做居中用的是含内边距的高度，实测箭头比输入框低 4dp。加在 AppBarLayout 上则
         工具栏内部排版走正常路径，返回箭头、输入框、「搜索」三者中心完全一致。
         两层底色同为 md_theme_surface，不会有色带。 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/search_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 高度钉 56dp：主题的 ?attr/actionBarSize 是 64dp，但内边距不在工具栏上之后，
             wrap_content 会让它取到 64dp，比改动前高 8dp。这里固定为改动前的 56dp，
             使本次只改「对齐」一件事。想要更宽松的上下留白（12dp）可换成 ?attr/actionBarSize。 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/search_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/md_theme_surface"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/_chevron_left"
            app:navigationIconTint="@color/md_theme_onSurfaceVariant">

            <!-- 输入框与「搜索」按钮必须包一层 LinearLayout：
                 MaterialToolbar 不处理子 View 的 layout_weight，加权 EditText 直接放里面
                 会被量成 0 宽（输入框整个看不见、点不进去）。样式见 SearchInputStyle。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_comment"
                    style="@style/SearchInputStyle" />

                <TextView
                    android:id="@+id/search_search"
                    style="@style/SearchActionStyle"
                    android:text="搜索" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 历史记录：标题 + 清空 + chip 流（无历史时整块隐藏） -->
    <LinearLayout
        android:id="@+id/search_history_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="历史记录"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/search_history_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="清空"
                android:textColor="@color/md_theme_outline"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/search_history_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp" />
    </LinearLayout>

    <!-- 猜你想搜 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:text="猜你想搜"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/search_suggested_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp" />

    <!-- 热点 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:text="热点"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/search_hot_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp" />

</LinearLayout>
