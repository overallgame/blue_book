<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <!-- 状态栏内边距加在这一层（与搜索页同一原因，见 AfterSearchFragment.initWindowInsets）：
         加在 MaterialToolbar 自身上会让它内部的返回键垂直居中算错，实测低 4dp -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/search_result_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 高度钉 56dp，与搜索页一致（理由见 search_page.xml） -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/search_result_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/md_theme_surface"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/_chevron_left"
            app:navigationIconTint="@color/md_theme_onSurfaceVariant">

            <!-- 与搜索页同理：MaterialToolbar 不处理 layout_weight，
                 加权 EditText 必须包在 LinearLayout 里，否则会被量成 0 宽。
                 样式与搜索页共用（见 SearchInputStyle）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/after_search_comment"
                    style="@style/SearchInputStyle" />

                <TextView
                    android:id="@+id/after_search_search"
                    style="@style/SearchActionStyle"
                    android:text="搜索" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/after_search_recycleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />

        <!-- 空态：搜索无结果 / 加载失败 -->
        <LinearLayout
            android:id="@+id/search_result_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/search_result_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无结果"
                android:textColor="@color/md_theme_outline"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/search_result_empty_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="重新加载"
                android:textColor="@color/md_theme_primary"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
