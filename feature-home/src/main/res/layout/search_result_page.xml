<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/search_result_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_surface"
            android:minHeight="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/_chevron_left1"
            app:navigationIconTint="@color/md_theme_onSurfaceVariant_mediumContrast">

            <!-- 与搜索页同理：MaterialToolbar 不处理 layout_weight，
                 加权 EditText 必须包在 LinearLayout 里，否则会被量成 0 宽 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/after_search_comment"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape1"
                    android:drawableStart="@drawable/search_icon2"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:hint="搜索视频"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/md_theme_primary"
                    android:textColorHint="@color/md_theme_outline"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/after_search_search"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="搜索"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/after_search_recycleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />

        <!-- 空态：搜索无结果 / 加载失败 -->
        <LinearLayout
            android:id="@+id/search_result_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/search_result_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无结果"
                android:textColor="@color/md_theme_outline"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/search_result_empty_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="重新加载"
                android:textColor="@color/md_theme_primary"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
