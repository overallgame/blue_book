<resources>
    <!--
      与 :app 的 values/style.xml 保持一致（同名的资源在最终 APK 里由 :app 的定义生效，
      这里保留一份是为了单独构建/预览本模块时也能解析；两处内容必须相同，
      否则一旦优先级变化就会渲染出不同结果）。

      横向不要加内边距：子 Tab 可用宽度很窄（实测 103px），
      两个汉字 16sp 需 64px，再加左右各 10dp 就会折行。
    -->
    <style name="RadioGroupButtonStyle">
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@drawable/navigation_item_selector</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="RadioGroupButtonStyle1">
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!--
      搜索输入框（搜索页与搜索结果页共用，避免两处各写一份而慢慢走样）。

      高度 40dp 与圆角 20dp 配套：圆角等于高度一半才是真正的胶囊。
      文字色用 onSurface 而不是 primary——primary 是强调色（品牌蓝 #2A6AF2），
      输入框里用户自己敲的字应当是正文色。

      单行 + actionSearch：不加 inputType 时 EditText 可换行，回车会插入换行把文字顶出可视区；
      imeOptions 让软键盘右下角显示「搜索」键（按键回调见 SearchFragment / AfterSearchFragment）。
    -->
    <style name="SearchInputStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_search_input</item>
        <item name="android:drawableStart">@drawable/search_icon2</item>
        <item name="android:drawablePadding">8dp</item>
        <!-- 图标与提示文字同色：两者都是「未激活」状态，原先图标用 onSurfaceVariant
             比提示文字深一大截，看起来像两个不相干的元素 -->
        <item name="android:drawableTint">@color/md_theme_outline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:hint">搜索视频</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textColorHint">@color/md_theme_outline</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 右侧「搜索」动作：品牌蓝（与登录页「获取验证码」同一套用色），高度对齐胶囊 -->
    <style name="SearchActionStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
