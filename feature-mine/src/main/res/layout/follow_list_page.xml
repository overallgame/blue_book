<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface">

    <LinearLayout
        android:id="@+id/follow_list_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/follow_list_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="返回"
            app:srcCompat="@drawable/_chevron_left" />

        <TextView
            android:id="@+id/follow_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="我的关注"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="我的关注" />
    </LinearLayout>

    <View
        android:id="@+id/follow_list_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/profile_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/follow_list_toolbar" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/follow_list_divider">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/follow_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_theme_surface"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- 空态：无数据 / 加载失败 -->
        <LinearLayout
            android:id="@+id/follow_list_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/follow_list_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无内容"
                android:textColor="@color/md_theme_outline"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/follow_list_empty_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="重新加载"
                android:textColor="@color/md_theme_primary"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
