<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_follow_item"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/follow_item_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/default_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/default_avatar" />

    <TextView
        android:id="@+id/follow_item_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/follow_item_btn"
        app:layout_constraintStart_toEndOf="@id/follow_item_avatar"
        app:layout_constraintTop_toTopOf="@id/follow_item_avatar"
        tools:text="用户昵称" />

    <TextView
        android:id="@+id/follow_item_bio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/md_theme_outline"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/follow_item_avatar"
        app:layout_constraintEnd_toStartOf="@id/follow_item_btn"
        app:layout_constraintStart_toEndOf="@id/follow_item_avatar"
        app:layout_constraintTop_toBottomOf="@id/follow_item_nickname"
        tools:text="TA的简介" />

    <TextView
        android:id="@+id/follow_item_btn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/shape_author_follow"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingHorizontal="14dp"
        android:text="关注"
        android:textColor="@color/mine_text_primary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/follow_item_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/follow_item_avatar"
        tools:text="已关注" />

</androidx.constraintlayout.widget.ConstraintLayout>
