<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 相机：实时扫码用。按项目实际做法「权限随使用它的模块走」——
         本模块被移除时，这个权限自动消失，不需要去 :app 清理。
         相册路径不需要它（媒体权限由 feature-image 自己处理），
         所以权限被拒时相册是有效降级路径。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application>
        <activity
            android:name="com.example.blue_book.ui.scan.ScanActivity"
            android:exported="false" />
    </application>

</manifest>
