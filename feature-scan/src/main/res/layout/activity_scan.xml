<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/scan_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/_chevron_left"
        app:navigationIconTint="@color/md_theme_onSurface"
        app:title="扫一扫"
        app:titleCentered="true"
        app:titleTextColor="@color/md_theme_onSurface" />

    <!-- 相机预览容器：CameraX 的 PreviewView 会在 3b 运行时创建并加进来 -->
    <FrameLayout
        android:id="@+id/scan_preview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_dark_background">

        <!-- 相机预览（3b）。权限被拒或无相机时保持 INVISIBLE，此时显示下面的提示 -->
        <androidx.camera.view.PreviewView
            android:id="@+id/scan_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/scan_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="正在准备相机…"
            android:textColor="@color/text_on_dark_tertiary"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- 相册入口：既是"从图里识别"的入口，也是相机权限被拒时的降级路径 -->
    <TextView
        android:id="@+id/scan_pick_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="从相册选择图片"
        android:textColor="@color/md_theme_primary"
        android:textSize="16sp" />

</LinearLayout>
