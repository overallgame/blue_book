<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 发布视频时定位城市（"本地"流使用，粗略定位即可） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application>
        <!-- 视频页已改为 MainActivity 内的 Tab Fragment（全屏相关的 configChanges
             也随之下移到 MainActivity）；发布页仍是独立页面 -->
        <activity
            android:name="com.example.blue_book.ui.publish.PublishActivity"
            android:exported="false" />

        <!-- 播放页（独立页面）：从非 Tab 页面点视频时压在上层，返回回到来源。
             configChanges 与 MainActivity 同：全屏要转横屏，重建会拆掉播放器 -->
        <activity
            android:name="com.example.blue_book.ui.video.VideoActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="false" />
    </application>
</manifest>
