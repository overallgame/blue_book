<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/video_progress_track_bg" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:angle="0" android:endColor="#FF6B6B" android:startColor="#6366F1" android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
