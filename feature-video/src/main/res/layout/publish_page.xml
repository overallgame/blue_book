<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/publish_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="?attr/actionBarSize"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:navigationIcon="@drawable/_chevron_left"
            app:navigationIconTint="@color/md_theme_onSurface"
            app:title="发布视频"
            app:titleCentered="true"
            app:titleTextColor="@color/md_theme_onSurface">

            <TextView
                android:id="@+id/publish_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/shape_follow_btn"
                android:paddingHorizontal="18dp"
                android:paddingVertical="7dp"
                android:text="发布"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- 已选视频预览 / 选择入口：小红书式横向 16:9 大卡片 -->
        <FrameLayout
            android:id="@+id/publish_media_container"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/shape_media_card"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/publish_media_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/publish_media_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/_ic_video_placeholder" />

                <TextView
                    android:id="@+id/publish_media_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="点击选择视频"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!--
          上次未完成的上传横幅（跨进程续传的入口）。
          只在本地账本里查到未完成任务时显示；文案里的百分比由本地分片账本算出，不等网络。
          动作是"填回表单"而不是"直接续传"——发布需要标题/描述，且上传完不发布只会在服务端
          留下一个没人认领的文件（见 PublishUiState.resumable 的说明）。
        -->
        <LinearLayout
            android:id="@+id/publish_resumable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/md_theme_surfaceContainer"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/publish_resumable_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/publish_resumable_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="继续"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/publish_resumable_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="忽略"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="标题"
            app:counterEnabled="true"
            app:counterMaxLength="30">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/publish_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_onSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="说点什么...（可加 #话题）"
            app:counterEnabled="true"
            app:counterMaxLength="200">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/publish_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:minLines="3"
                android:maxLines="6"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_onSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 上传进度 -->
        <LinearLayout
            android:id="@+id/publish_progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/publish_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="@color/brand_blue"
                app:trackColor="@color/md_theme_surfaceContainer" />

            <TextView
                android:id="@+id/publish_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minWidth="40dp"
                android:gravity="end"
                android:text="0%"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="12sp" />

            <!-- 取消上传：上传动辄几分钟，没有出口的进度条等于把用户锁在页面里 -->
            <TextView
                android:id="@+id/publish_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="取消"
                android:textColor="@color/md_theme_primary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="发布后视频将进入转码队列，转码完成后对所有用户可见"
            android:textColor="@color/md_theme_outline"
            android:textSize="12sp" />

    </LinearLayout>
</LinearLayout>
