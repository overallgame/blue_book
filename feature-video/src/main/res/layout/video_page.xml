<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/video_viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 发布入口：悬浮右下角 -->
    <ImageView
        android:id="@+id/video_publish"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/shape_follow_btn"
        android:contentDescription="发布视频"
        android:padding="12dp"
        android:src="@drawable/_ic_add_white" />

    <!-- 空列表态：搜索无结果 / 数据加载失败后列表为空 -->
    <LinearLayout
        android:id="@+id/video_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/video_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无相关视频"
            android:textColor="@color/video_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/video_empty_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_video_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="重新加载"
            android:textColor="@color/video_on_surface"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
