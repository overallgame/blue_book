<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ★ 这是**全项目唯一的浅色色板定义**。各 feature 与 :app 都不再各存一份：
        库模块的资源必须自洽（只依赖 :app 的色板会让 aapt 找不到资源），而所有模块都依赖
        lib-base，所以它是唯一能放共享色板的地方。夜版在 values-night/colors.xml。
        曾经的做法是每个模块各存一份、由资源合并优先级决定谁生效——feature-message 的
        md_theme_onSurfaceVariant 就与 app 差一个色阶且静默失效（app 赢），无人察觉。

      浅色主题色板：纯中性灰 + 单一强调色。

      2026-09-20 换色说明——原色板是以「灰色种子」生成的 M3 色阶，两处问题：
        1. 中性色带明显的粉紫底：surface #FDF8F8（粉白）、surfaceContainer #F1EDED、
           surfaceVariant #E6E1E7、primaryContainer #F4EEF6（淡紫）、tertiaryContainer #FCECF0（粉）。
           压在品牌蓝上发脏，不像常规 App 的浅色主题。
        2. primary 是灰的 #605D64，且被用作「重试」等动作文字（9 处），看起来像禁用态。

      现在改成常规浅色主题的取色：白 / 中性灰分层、近黑正文、灰色次要文字、浅灰分割线；
      品牌蓝只作强调色（primary）用在动作文字与水波纹上，不再由它派生任何 M3 色阶。

      ★ 分层约定（改颜色前先读）：
          surfaceContainer = 页面底（灰）   surface = 内容 / 卡片（白）
        布局里就是这么用的，不要反向，否则卡片会从页面上「消失」。
    -->
    <!-- 强调色：品牌蓝。仅此一处用品牌色，用于「重试」等动作文字与 ?attr/colorPrimary 的水波纹 -->
    <color name="md_theme_primary">#2A6AF2</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryContainer">#EEEEEE</color>
    <color name="md_theme_onPrimaryContainer">#666666</color>
    <color name="md_theme_secondary">#666666</color>
    <color name="md_theme_onSecondary">#FFFFFF</color>
    <color name="md_theme_secondaryContainer">#EEEEEE</color>
    <color name="md_theme_onSecondaryContainer">#1A1A1A</color>
    <color name="md_theme_tertiary">#666666</color>
    <color name="md_theme_onTertiary">#FFFFFF</color>
    <color name="md_theme_tertiaryContainer">#EEEEEE</color>
    <color name="md_theme_onTertiaryContainer">#1A1A1A</color>
    <color name="md_theme_error">#BA1A1A</color>
    <color name="md_theme_onError">#FFFFFF</color>
    <color name="md_theme_errorContainer">#FFDAD6</color>
    <color name="md_theme_onErrorContainer">#410002</color>
    <color name="md_theme_background">#FFFFFF</color>
    <color name="md_theme_onBackground">#1A1A1A</color>
    <!-- 内容 / 卡片层：纯白 -->
    <color name="md_theme_surface">#FFFFFF</color>
    <!-- 正文 -->
    <color name="md_theme_onSurface">#1A1A1A</color>
    <color name="md_theme_surfaceVariant">#F2F2F2</color>
    <!-- 次要文字：白底 5.7:1，灰底 5.3:1，均过 WCAG AA -->
    <color name="md_theme_onSurfaceVariant">#666666</color>
    <!-- 提示 / 占位 / 弱化文字与图标（"暂无内容"、时间戳、输入框 hint） -->
    <color name="md_theme_outline">#999999</color>
    <!-- 分割线 / 搜索输入框描边。注意：它必须比 surfaceContainerHighest 深，
         否则搜索框的描边会比填充还浅、轮廓内外翻转（bg_search_input.xml 依赖这个关系）。
         目前实际用到它的只有搜索框描边——应用里的分割线各用自己的色（profile_divider 等）。 -->
    <color name="md_theme_outlineVariant">#E0E0E0</color>
    <color name="md_theme_scrim">#000000</color>
    <color name="md_theme_inverseSurface">#1A1A1A</color>
    <color name="md_theme_inverseOnSurface">#F5F5F5</color>
    <color name="md_theme_inversePrimary">#E0E0E0</color>
    <color name="md_theme_primaryFixed">#EEEEEE</color>
    <color name="md_theme_onPrimaryFixed">#1A1A1A</color>
    <color name="md_theme_primaryFixedDim">#E0E0E0</color>
    <color name="md_theme_onPrimaryFixedVariant">#666666</color>
    <color name="md_theme_secondaryFixed">#EEEEEE</color>
    <color name="md_theme_onSecondaryFixed">#1A1A1A</color>
    <color name="md_theme_secondaryFixedDim">#E0E0E0</color>
    <color name="md_theme_onSecondaryFixedVariant">#666666</color>
    <color name="md_theme_tertiaryFixed">#EEEEEE</color>
    <color name="md_theme_onTertiaryFixed">#1A1A1A</color>
    <color name="md_theme_tertiaryFixedDim">#E0E0E0</color>
    <color name="md_theme_onTertiaryFixedVariant">#666666</color>
    <color name="md_theme_surfaceDim">#DDDDDD</color>
    <color name="md_theme_surfaceBright">#FFFFFF</color>
    <color name="md_theme_surfaceContainerLowest">#FFFFFF</color>
    <!-- 搜索输入框底、侧边抽屉底（衬在白页面上的浅灰块） -->
    <color name="md_theme_surfaceContainerLow">#F7F7F7</color>
    <!-- 页面底：首页瀑布流、消息、我的各列表、资料页等 -->
    <color name="md_theme_surfaceContainer">#F5F5F5</color>
    <color name="md_theme_surfaceContainerHigh">#F2F2F2</color>
    <!-- 搜索输入框的填充（bg_search_input.xml） -->
    <color name="md_theme_surfaceContainerHighest">#F0F0F0</color>


    <!--
      以下为跨模块共用的语义色（不随主题翻转的常量色）。新增颜色前先看这里有没有同义的，
      不要在各业务模块里另起一套同义色名（品牌蓝、深色底文字色历史上各重复过三四份）。
    -->

    <!-- 公用卡片（pre_video_item_view）：跟随主题 -->
    <color name="lib_card_background">#FFFFFF</color>

    <!-- 登录引导卡片（品牌蓝，与登录页一致；夜版见 values-night） -->
    <color name="login_guide_card_background">#FFFFFF</color>

    <!-- 品牌色（原 brand_blue / auth_primary_blue / login_guide_primary / video_brand_blue 四处重复） -->
    <color name="brand_blue">#FF2A6AF2</color>

    <!-- 品牌色按钮上的文字（登录/注册按钮、发布弹层发送键）：品牌蓝不随主题变浅，
         所以它上面的文字必须是常量白，不能引用会随主题翻转的 md_theme_onPrimary -->
    <color name="brand_on_blue">#FFFFFF</color>

    <!-- 恒定深色页面的底色：我的 / 作者主页的封面式背景，两种主题下都是深色 -->
    <color name="page_dark_background">#333232</color>

    <!-- 深色底上的文字色（视频播放页、封面式页面）。
         必须是常量：这些页面不随主题变浅，而 md_theme_onSurface 在浅色主题下是深色，
         压在深色底上会看不见。取值与夜间主题的 md_theme_onSurface / onSurfaceVariant / outline 对齐。 -->
    <color name="text_on_dark_primary">#E6E1E2</color>
    <color name="text_on_dark_secondary">#CAC5CB</color>
    <color name="text_on_dark_tertiary">#938F95</color>

    <!-- 深色底上的错误文字（对齐夜间主题的 md_theme_error） -->
    <color name="text_on_dark_error">#F2B8B5</color>
</resources>
